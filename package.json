{
  "name": "aura-wallet",
  "version": "27.27.60",
  "description": "Open-source self-custody Bitcoin wallet for iOS and Android.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurabitcoinwallet/aura-wallet.git"
  },
  "homepage": "https://github.com/aurabitcoinwallet/aura-wallet",
  "bugs": {
    "url": "https://github.com/aurabitcoinwallet/aura-wallet/issues"
  },
  "keywords": [
    "bitcoin",
    "bitcoin-wallet",
    "self-custody",
    "react-native",
    "ios",
    "android",
    "typescript",
    "electrum",
    "multisig"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings=0",
    "start": "react-native start",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:security": "node scripts/release-security.test.js && node scripts/aura-security.test.js && node scripts/aura-alerts.test.js && node --import tsx scripts/aura-block-explorer.test.ts && node --import tsx scripts/aura-text-encoding.test.ts",
    "test:vectors": "node scripts/aura-vectors.test.js",
    "test:selftest": "node --import ./scripts/register.mjs --import tsx ./scripts/aura-selftest.ts",
    "security:check": "npm run test:security",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:security && npm run test:vectors && npm run test:selftest"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/blur": "4.4.1",
    "@react-native-community/push-notification-ios": "1.12.0",
    "@react-native-menu/menu": "2.0.0",
    "@react-native-vector-icons/ionicons": "13.1.1",
    "@react-native-vector-icons/material-design-icons": "13.1.2",
    "@react-native-vector-icons/material-icons": "13.1.2",
    "@borewit/text-codec": "0.2.2",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/native-stack": "7.18.6",
    "@scure/bip39": "2.2.0",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.21",
    "qr": "0.5.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-biometrics": "3.0.1",
    "react-native-camera-kit": "18.0.0",
    "react-native-get-random-values": "2.0.0",
    "react-native-haptic-feedback": "2.3.4",
    "react-native-image-picker": "8.2.1",
    "react-native-keychain": "9.2.3",
    "react-native-linear-gradient": "2.8.3",
    "react-native-permissions": "5.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-tcp-socket": "6.4.1",
    "react-native-url-polyfill": "3.0.0",
    "rn-qr-generator": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@scure/bip32": "^1.7.0",
    "@scure/btc-signer": "^1.8.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
